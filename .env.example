# Copy to `.env` and fill in the keys:
#
#   cp .env.example .env
#
# One file serves both entry points. `skylore.agent.loop.load_env` reads it for the CLI
# and the evaluation scripts, and `docker compose` reads it from this directory on its
# own, which is why the Postgres and port settings live here next to the model ones.
#
# The parser is deliberately small: `KEY=value` a line, `#` only at the start of a line.
# An inline comment after a value becomes part of the value, so there are none below.
# Nothing here overwrites what the shell already exports, and a command-line flag
# overrides both.

# ──────────────────────────────────── the keys ────────────────────────────────────
# The provider key is the one thing the project cannot supply itself. Set the one that
# matches SKYLORE_PROVIDER below; the other can stay empty.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Web search. Optional, and absence is a supported state rather than an error: the CLI
# leaves the tool out and the chat disables its toggle when this is unset.
TAVILY_API_KEY=

# ─────────────────────────── how this deployment answers ───────────────────────────
# Read by the entry points (`python -m skylore.agent`, `python -m scripts.evaluate_agent`)
# via `skylore.agent.loop.load_env`, never by the library itself. Each line below is the
# constant the code falls back to, so an untouched copy of this file changes nothing.

# Which model answers. A number from an evaluation means nothing without it, so it is a
# setting rather than a constant to edit.
SKYLORE_MODEL=gpt-5.4-mini

# The language answers and names come back in. A default, not a policy: --lang overrides
# it per question, and the model still has to carry it into its own tool calls.
SKYLORE_LANG=en

# openai or openrouter. The key above decides nothing on its own.
SKYLORE_PROVIDER=openai

# ───────────────────────────── what an eval run may spend ─────────────────────────────
# The ceiling is arithmetic, not advice: cases run = BUDGET / (CAP + judge allowance),
# and CAP is enforced inside the client as UsageLimits(cost_limit=...), so a model that
# decides to read every article stops instead of spending the sweep's budget on one
# question. Both are printed before the first request.

# Dollars a whole sweep may cost.
SKYLORE_EVAL_BUDGET=0.50

# Dollars one question may cost.
SKYLORE_EVAL_CAP=0.03

# Who grades the prose. Deliberately not SKYLORE_MODEL: a model grading its own output
# prefers it.
SKYLORE_JUDGE_MODEL=openai:gpt-5.2

# ────────────────────────────── the monitoring store ──────────────────────────────
# Read by `skylore.monitor` and, under the same names, by docker-compose. These are the
# defaults both sides already assume, so `docker compose up` needs none of them; they
# are spelled out because the one that is not a default is POSTGRES_HOST. Inside the
# stack the host is the service name, from the host it is localhost -- which is what
# `python -m skylore.monitor stats` and `scripts.evaluate_agent --record` need.
POSTGRES_DB=skylore
POSTGRES_USER=skylore
POSTGRES_PASSWORD=skylore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host ports only; inside the stack nothing moves. 8501 is Streamlit's default and 5432
# is Postgres', and a development machine usually has another project holding both.
APP_PORT=8501
GRAFANA_PORT=3000
